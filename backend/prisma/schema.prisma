datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Role Enum & User Entity
enum Role {
  ADMIN
  MANAGER
  SALE
  CUSTOMER
}

model User {
  id                Int                @id @default(autoincrement())
  username          String             @unique
  passwordHash      String             @map("password_hash")
  fullName          String             @map("full_name")
  role              Role
  isActive          Boolean            @default(true) @map("is_active")
  lastActiveAt      DateTime?          @default(now()) @map("last_active_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  wallet            Wallet?
  autoDebitSetting  AutoDebitSetting?
  autoDebitConsents AutoDebitConsent[]
  debts             Debt[]
  customerBookings  Booking[]          @relation("CustomerBookings")

  @@map("users")
}

// 2. Room Enums & Entity
enum RoomType {
  VIP
  DELUX
  LIVING_SUITE
}

enum RoomSize {
  SINGLE
  DOUBLE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

model Room {
  roomId        String           @id @map("room_id") // ví dụ: "101", "102"
  type          RoomType
  size          RoomSize
  price         Decimal          @db.Decimal(12, 2)
  maxAdults     Int              @map("max_adults")
  maxChildren   Int              @map("max_children")
  extraChildFee Decimal          @map("extra_child_fee") @db.Decimal(12, 2)
  description   String?
  pictures      String[]         @default([])
  status        RoomStatus       @default(AVAILABLE)
  createdAt     DateTime         @default(now()) @map("created_at")
  assignments   RoomAssignment[]

  @@map("rooms")
}

// 3. Service Entity
model Service {
  serviceId    String         @id @map("service_id") // ví dụ: "SRV-01"
  serviceName  String         @map("service_name")
  description  String?
  unit         String
  price        Decimal        @db.Decimal(12, 2)
  createdAt    DateTime       @default(now()) @map("created_at")
  serviceUsage ServiceUsage[]

  @@map("services")
}

// 4. Promotion Enum & Entity
enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Promotion {
  id           String       @id @default(uuid())
  code         String       @unique
  name         String
  description  String?
  discountType DiscountType @map("discount_type")
  value        Decimal      @db.Decimal(12, 2)
  startDate    DateTime     @map("start_date")
  endDate      DateTime     @map("end_date")
  createdAt    DateTime     @default(now()) @map("created_at")
  bookings     Booking[]

  @@map("promotions")
}

// 5. PaymentAccount Enum & Entity
enum CardType {
  ATM
  VISA
}

model PaymentAccount {
  id            Int      @id @default(autoincrement())
  cardType      CardType @map("card_type")
  accountNumber String   @unique @map("account_number")
  accountHolder String   @map("account_holder")
  balance       Decimal  @db.Decimal(15, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("payment_accounts")
}

// 6. Booking Enums & Entity
enum PaymentOption {
  FULL_100
  DEPOSIT_50
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
}

model Booking {
  id                   Int              @id @default(autoincrement())
  bookingNumber        String           @unique @map("booking_number") // BK-YYYYMMDD-XXXX
  customerId           Int?             @map("customer_id")
  customer             User?            @relation("CustomerBookings", fields: [customerId], references: [id])
  customerName         String           @map("customer_name")
  customerPhone        String           @map("customer_phone")
  customerEmail        String           @map("customer_email")
  customerCccd         String           @map("customer_cccd")
  fromDate             DateTime         @map("from_date")
  toDate               DateTime         @map("to_date")
  promotionId          String?          @map("promotion_id")
  promotion            Promotion?       @relation(fields: [promotionId], references: [id])
  totalRoomFee         Decimal          @map("total_room_fee") @db.Decimal(12, 2)
  discountAmount       Decimal          @default(0) @map("discount_amount") @db.Decimal(12, 2)
  netRoomFee           Decimal          @map("net_room_fee") @db.Decimal(12, 2)
  paymentOption        PaymentOption    @map("payment_option")
  prepaidBookingValue  Decimal          @map("prepaid_booking_value") @db.Decimal(12, 2)
  paymentAccountNumber String           @map("payment_account_number")
  cancellationFee      Decimal?         @map("cancellation_fee") @db.Decimal(12, 2)
  refundAmount         Decimal?         @map("refund_amount") @db.Decimal(12, 2)
  extraChildrenFee     Decimal          @default(0) @map("extra_children_fee") @db.Decimal(12, 2)
  status               BookingStatus    @default(CONFIRMED)
  createdAt            DateTime         @default(now()) @map("created_at")
  cancelledAt          DateTime?        @map("cancelled_at")
  checkedOutAt         DateTime?        @map("checked_out_at")
  items                BookingItem[]
  assignments          RoomAssignment[]
  guests               StayingGuest[]
  serviceUsages        ServiceUsage[]
  invoice              Invoice?
  debts                Debt[]

  @@map("bookings")
}

// 7. BookingItem Entity
model BookingItem {
  id        Int      @id @default(autoincrement())
  bookingId Int      @map("booking_id")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomType  RoomType @map("room_type")
  roomSize  RoomSize @map("room_size")
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)

  @@map("booking_items")
}

// 8. RoomAssignment Entity
model RoomAssignment {
  id         Int            @id @default(autoincrement())
  bookingId  Int            @map("booking_id")
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomId     String         @map("room_id")
  room       Room           @relation(fields: [roomId], references: [roomId])
  checkInAt  DateTime       @default(now()) @map("check_in_at")
  checkOutAt DateTime?      @map("check_out_at")
  guests     StayingGuest[]

  @@map("room_assignments")
}

// 9. StayingGuest Enum & Entity
enum GuestType {
  ADULT
  CHILD
}

model StayingGuest {
  id               Int            @id @default(autoincrement())
  bookingId        Int            @map("booking_id")
  booking          Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomAssignmentId Int            @map("room_assignment_id")
  roomAssignment   RoomAssignment @relation(fields: [roomAssignmentId], references: [id], onDelete: Cascade)
  fullName         String         @map("full_name")
  idNumber         String         @map("id_number")
  birthYear        Int            @map("birth_year")
  guestType        GuestType      @map("guest_type")

  @@map("staying_guests")
}

// 10. ServiceUsage Enums & Entity
enum ServiceUsageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ServiceUsage {
  ticketId   String             @id @map("ticket_id") // TK-YYYYMMDD-XXXX
  bookingId  Int                @map("booking_id")
  booking    Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomId     String             @map("room_id")
  serviceId  String             @map("service_id")
  service    Service            @relation(fields: [serviceId], references: [serviceId])
  quantity   Int
  unitPrice  Decimal            @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal            @map("total_price") @db.Decimal(12, 2)
  status     ServiceUsageStatus @default(COMPLETED)
  isPaid     Boolean            @default(false) @map("is_paid")
  createdAt  DateTime           @default(now()) @map("created_at")
  debts      Debt[]

  @@map("service_usage")
}

// 11. Invoice Entity
model Invoice {
  invoiceId           String   @id @map("invoice_id") // INV-YYYYMMDD-XXXX
  bookingId           Int      @unique @map("booking_id")
  booking             Booking  @relation(fields: [bookingId], references: [id])
  totalRoomFee        Decimal  @map("total_room_fee") @db.Decimal(12, 2)
  extraChildrenFee    Decimal  @default(0) @map("extra_children_fee") @db.Decimal(12, 2)
  totalServiceFee     Decimal  @default(0) @map("total_service_fee") @db.Decimal(12, 2)
  totalInvoiceAmount  Decimal  @map("total_invoice_amount") @db.Decimal(12, 2)
  prepaidBookingValue Decimal  @map("prepaid_booking_value") @db.Decimal(12, 2)
  remainingPayable    Decimal  @map("remaining_payable") @db.Decimal(12, 2)
  walletPaidAmount    Decimal  @default(0) @map("wallet_paid_amount") @db.Decimal(12, 2)
  issuedAt            DateTime @default(now()) @map("issued_at")

  @@map("invoices")
}

// ==========================================
// AUTO-DEBIT & INTERNAL WALLET (FEAT-13)
// ==========================================

// 12. Wallet Enums & Entity
enum WalletStatus {
  ACTIVE
  LOCKED
}

model Wallet {
  id           Int                 @id @default(autoincrement())
  walletNumber String              @unique @map("wallet_number") // WAL-YYYYMMDD-XXXX
  userId       Int                 @unique @map("user_id")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency     String              @default("VND")
  balance      Decimal             @default(0) @db.Decimal(15, 2)
  status       WalletStatus        @default(ACTIVE)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  transactions WalletTransaction[]
  debts        Debt[]
  refunds      Refund[]

  @@map("wallets")
}

// 13. WalletTransaction Enums & Entity
enum TransactionType {
  TOP_UP_MOCK
  AUTO_DEBIT_DEBT
  AUTO_DEBIT_SERVICE
  MANUAL_PAYMENT
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model WalletTransaction {
  id            Int                 @id @default(autoincrement())
  transactionNo String              @unique @map("transaction_no") // WTX-YYYYMMDD-XXXX
  walletId      Int                 @map("wallet_id")
  wallet        Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          TransactionType
  amount        Decimal             @db.Decimal(15, 2)
  balanceBefore Decimal             @map("balance_before") @db.Decimal(15, 2)
  balanceAfter  Decimal             @map("balance_after") @db.Decimal(15, 2)
  status        TransactionStatus   @default(SUCCESS)
  description   String?
  debtId        Int?                @map("debt_id")
  debt          Debt?               @relation(fields: [debtId], references: [id])
  originalTxId  Int?                @map("original_tx_id")
  originalTx    WalletTransaction?  @relation("TransactionRefunds", fields: [originalTxId], references: [id])
  refundTxs     WalletTransaction[] @relation("TransactionRefunds")
  refunds       Refund[]
  metadata      Json?
  createdAt     DateTime            @default(now()) @map("created_at")

  @@map("wallet_transactions")
}

// 14. AutoDebitSetting Enums & Entity
enum AutoDebitStatus {
  NOT_ENABLED
  PENDING_ADMIN
  ACTIVE
  PAUSED
  DISABLED
}

model AutoDebitSetting {
  id          Int             @id @default(autoincrement())
  userId      Int             @unique @map("user_id")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      AutoDebitStatus @default(NOT_ENABLED)
  activatedAt DateTime?       @map("activated_at")
  pausedAt    DateTime?       @map("paused_at")
  disabledAt  DateTime?       @map("disabled_at")
  updatedBy   String?         @map("updated_by") // Tên tài khoản Admin kích hoạt/tạm ngừng
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("auto_debit_settings")
}

// 15. AutoDebitConsent Entity
model AutoDebitConsent {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion String   @map("terms_version") // Ví dụ: "v1.0"
  termsContent String   @map("terms_content") @db.Text
  agreedAt     DateTime @default(now()) @map("agreed_at")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  isActive     Boolean  @default(true) @map("is_active")

  @@map("auto_debit_consents")
}

// 16. Debt Enums & Entity
enum DebtType {
  BOOKING_BALANCE
  SERVICE_FEE
}

enum DebtStatus {
  UNPAID
  OVERDUE
  PAID
  CANCELLED
}

model Debt {
  id           Int                 @id @default(autoincrement())
  debtCode     String              @unique @map("debt_code") // DBT-YYYYMMDD-XXXX
  userId       Int                 @map("user_id")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId     Int?                @map("wallet_id")
  wallet       Wallet?             @relation(fields: [walletId], references: [id])
  bookingId    Int?                @map("booking_id")
  booking      Booking?            @relation(fields: [bookingId], references: [id])
  ticketId     String?             @map("ticket_id")
  serviceUsage ServiceUsage?       @relation(fields: [ticketId], references: [ticketId])
  type         DebtType
  amount       Decimal             @db.Decimal(12, 2)
  paidAmount   Decimal             @default(0) @map("paid_amount") @db.Decimal(12, 2)
  status       DebtStatus          @default(UNPAID)
  dueDate      DateTime            @map("due_date")
  paidAt       DateTime?           @map("paid_at")
  note         String?
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  transactions WalletTransaction[]

  @@map("debts")
}

// 17. Refund Enums & Entity
enum RefundStatus {
  PENDING
  COMPLETED
  REJECTED
}

model Refund {
  id           Int               @id @default(autoincrement())
  refundCode   String            @unique @map("refund_code") // RFD-YYYYMMDD-XXXX
  walletId     Int               @map("wallet_id")
  wallet       Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  originalTxId Int               @map("original_tx_id")
  originalTx   WalletTransaction @relation(fields: [originalTxId], references: [id])
  amount       Decimal           @db.Decimal(15, 2)
  reason       String            @db.Text
  status       RefundStatus      @default(COMPLETED)
  approvedBy   String            @map("approved_by") // Admin username
  processedAt  DateTime          @default(now()) @map("processed_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  @@map("refunds")
}
