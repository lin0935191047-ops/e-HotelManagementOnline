datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Role Enum & User Entity
enum Role {
  ADMIN
  MANAGER
  SALE
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  role         Role
  isActive     Boolean   @default(true) @map("is_active")
  lastActiveAt DateTime? @default(now()) @map("last_active_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("users")
}

// 2. Room Enums & Entity
enum RoomType {
  VIP
  DELUX
  LIVING_SUITE
}

enum RoomSize {
  SINGLE
  DOUBLE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

model Room {
  roomId        String           @id @map("room_id") // ví dụ: "101", "102"
  type          RoomType
  size          RoomSize
  price         Decimal          @db.Decimal(12, 2)
  maxAdults     Int              @map("max_adults")
  maxChildren   Int              @map("max_children")
  extraChildFee Decimal          @map("extra_child_fee") @db.Decimal(12, 2)
  description   String?
  pictures      String[]         @default([])
  status        RoomStatus       @default(AVAILABLE)
  createdAt     DateTime         @default(now()) @map("created_at")
  assignments   RoomAssignment[]

  @@map("rooms")
}

// 3. Service Entity
model Service {
  serviceId    String         @id @map("service_id") // ví dụ: "SRV-01"
  serviceName  String         @map("service_name")
  description  String?
  unit         String
  price        Decimal        @db.Decimal(12, 2)
  createdAt    DateTime       @default(now()) @map("created_at")
  serviceUsage ServiceUsage[]

  @@map("services")
}

// 4. Promotion Enum & Entity
enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Promotion {
  id           String       @id @default(uuid())
  code         String       @unique
  name         String
  description  String?
  discountType DiscountType @map("discount_type")
  value        Decimal      @db.Decimal(12, 2)
  startDate    DateTime     @map("start_date")
  endDate      DateTime     @map("end_date")
  createdAt    DateTime     @default(now()) @map("created_at")
  bookings     Booking[]

  @@map("promotions")
}

// 5. PaymentAccount Enum & Entity
enum CardType {
  ATM
  VISA
}

model PaymentAccount {
  id            Int      @id @default(autoincrement())
  cardType      CardType @map("card_type")
  accountNumber String   @unique @map("account_number")
  accountHolder String   @map("account_holder")
  balance       Decimal  @db.Decimal(15, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("payment_accounts")
}

// 6. Booking Enums & Entity
enum PaymentOption {
  FULL_100
  DEPOSIT_50
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
}

model Booking {
  id                   Int              @id @default(autoincrement())
  bookingNumber        String           @unique @map("booking_number") // BK-YYYYMMDD-XXXX
  customerName         String           @map("customer_name")
  customerPhone        String           @map("customer_phone")
  customerEmail        String           @map("customer_email")
  customerCccd         String           @map("customer_cccd")
  fromDate             DateTime         @map("from_date")
  toDate               DateTime         @map("to_date")
  promotionId          String?          @map("promotion_id")
  promotion            Promotion?       @relation(fields: [promotionId], references: [id])
  totalRoomFee         Decimal          @map("total_room_fee") @db.Decimal(12, 2)
  discountAmount       Decimal          @default(0) @map("discount_amount") @db.Decimal(12, 2)
  netRoomFee           Decimal          @map("net_room_fee") @db.Decimal(12, 2)
  paymentOption        PaymentOption    @map("payment_option")
  prepaidBookingValue  Decimal          @map("prepaid_booking_value") @db.Decimal(12, 2)
  paymentAccountNumber String           @map("payment_account_number")
  cancellationFee      Decimal?         @map("cancellation_fee") @db.Decimal(12, 2)
  refundAmount         Decimal?         @map("refund_amount") @db.Decimal(12, 2)
  extraChildrenFee     Decimal          @default(0) @map("extra_children_fee") @db.Decimal(12, 2)
  status               BookingStatus    @default(CONFIRMED)
  createdAt            DateTime         @default(now()) @map("created_at")
  cancelledAt          DateTime?        @map("cancelled_at")
  checkedOutAt         DateTime?        @map("checked_out_at")
  items                BookingItem[]
  assignments          RoomAssignment[]
  guests               StayingGuest[]
  serviceUsages        ServiceUsage[]
  invoice              Invoice?

  @@map("bookings")
}

// 7. BookingItem Entity
model BookingItem {
  id        Int      @id @default(autoincrement())
  bookingId Int      @map("booking_id")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomType  RoomType @map("room_type")
  roomSize  RoomSize @map("room_size")
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)

  @@map("booking_items")
}

// 8. RoomAssignment Entity
model RoomAssignment {
  id         Int            @id @default(autoincrement())
  bookingId  Int            @map("booking_id")
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomId     String         @map("room_id")
  room       Room           @relation(fields: [roomId], references: [roomId])
  checkInAt  DateTime       @default(now()) @map("check_in_at")
  checkOutAt DateTime?      @map("check_out_at")
  guests     StayingGuest[]

  @@map("room_assignments")
}

// 9. StayingGuest Enum & Entity
enum GuestType {
  ADULT
  CHILD
}

model StayingGuest {
  id               Int            @id @default(autoincrement())
  bookingId        Int            @map("booking_id")
  booking          Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomAssignmentId Int            @map("room_assignment_id")
  roomAssignment   RoomAssignment @relation(fields: [roomAssignmentId], references: [id], onDelete: Cascade)
  fullName         String         @map("full_name")
  idNumber         String         @map("id_number")
  birthYear        Int            @map("birth_year")
  guestType        GuestType      @map("guest_type")

  @@map("staying_guests")
}

// 10. ServiceUsage Entity
model ServiceUsage {
  ticketId   String   @id @map("ticket_id")
  bookingId  Int      @map("booking_id")
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomId     String   @map("room_id")
  serviceId  String   @map("service_id")
  service    Service  @relation(fields: [serviceId], references: [serviceId])
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal  @map("total_price") @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("service_usage")
}

// 11. Invoice Entity
model Invoice {
  invoiceId           String   @id @map("invoice_id")
  bookingId           Int      @unique @map("booking_id")
  booking             Booking  @relation(fields: [bookingId], references: [id])
  totalRoomFee        Decimal  @map("total_room_fee") @db.Decimal(12, 2)
  extraChildrenFee    Decimal  @default(0) @map("extra_children_fee") @db.Decimal(12, 2)
  totalServiceFee     Decimal  @default(0) @map("total_service_fee") @db.Decimal(12, 2)
  totalInvoiceAmount  Decimal  @map("total_invoice_amount") @db.Decimal(12, 2)
  prepaidBookingValue Decimal  @map("prepaid_booking_value") @db.Decimal(12, 2)
  remainingPayable    Decimal  @map("remaining_payable") @db.Decimal(12, 2)
  issuedAt            DateTime @default(now()) @map("issued_at")

  @@map("invoices")
}
